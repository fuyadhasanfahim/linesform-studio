# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Public site URL used for canonical links, sitemap and Open Graph.
SITE_URL=https://linesformstudio.com

# Optional: shown in the footer and contact section only when set.
CONTACT_EMAIL=

# Enquiry delivery. When unset, the form validates but reports that nothing was sent.
# Must be https (http is accepted only for localhost).
ENQUIRY_WEBHOOK_URL=
# Optional bearer token sent as `Authorization: Bearer <value>`.
ENQUIRY_WEBHOOK_SECRET=

# Asset generation (local scripts only — never exposed to the browser).
GEMINI_API_KEY=
IMAGE_GEN_MODEL_NAME=gemini-nano-banana-2.1
VIDEO_GEN_MODEL_NAME=gemini-omni-1.1-flash
